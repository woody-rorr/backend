# === Runtime (07-env-and-secrets.md §1) ===
NODE_ENV=development
PORT=5013
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# === Database — Aurora PostgreSQL 16.4 (04-data-layer.md §1) ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=backend
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# === JWT — HS256 (auth_patterns.md §2) ===
JWT_SECRET=change-me-to-a-random-string-min-32-chars
JWT_EXPIRES_IN=1h
# RS256 only (leave empty for HS256):
# JWT_PUBLIC_KEY=

# === Migrations (db_migration.md §6) ===
RUN_MIGRATIONS=false
