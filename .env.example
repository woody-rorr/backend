# new-project API — environment variables (07-env-and-secrets.md §1)
NODE_ENV=production
PORT=5013
LOG_LEVEL=info
CORS_ORIGINS=https://app.example.com

DB_HOST=<rds-endpoint>
DB_PORT=5432
DB_NAME=backend
DB_USER=postgres
DB_PASSWORD=changeme
DB_SSL=true

JWT_SECRET=changeme-min-32-chars-random-secret
JWT_EXPIRES_IN=1h

RUN_MIGRATIONS=false
