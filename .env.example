# new-project API — environment variables
# Source of truth: 07-env-and-secrets.md §1. Only variables listed there are valid.

# --- runtime (task-def) ---
NODE_ENV=production
PORT=5013
LOG_LEVEL=info
CORS_ORIGINS=https://app.example.com

# --- database ---
DB_HOST=mcp-test.cluster-cwjiw4y08fiq.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=backend
DB_USER=postgres
DB_PASSWORD=changeme
DB_SSL=true

# --- auth (JWT, HS256) ---
JWT_SECRET=please-change-this-to-a-32+char-random-secret
# JWT_PUBLIC_KEY is only used when RS256 is selected
# JWT_PUBLIC_KEY=
JWT_EXPIRES_IN=1h

# --- migrations ---
RUN_MIGRATIONS=false
